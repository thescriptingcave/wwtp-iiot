# ─────────────────────────────────────────────────────────────────────────────
# wwtp-iiot — example environment
#
# Copy to .env and fill in real values:      cp .env.example .env
# .env is gitignored. NEVER commit real values here.
# Every value below has a safe placeholder so the stack is runnable before you
# have credentials. The two marked REQUIRED have no working default.
# ─────────────────────────────────────────────────────────────────────────────

# ─── InfluxDB 3 (Enterprise, free home-use licence) ───────────────────────────
# Home-use licence: non-commercial, at-home, single-node. See docs/SECURITY.md.
# REQUIRED — obtain from InfluxData; the container will not start without it.
INFLUX_LICENSE_KEY=replace-me-with-your-home-use-licence-key

# The token the gateway uses. For a local single-node instance this is created by
# you during setup (InfluxDB UI → Organization → API Tokens), NOT a Cloud token.
INFLUX_TOKEN=replace-me
INFLUX_DATABASE=wwtp
INFLUX_ORG=wwtp
INFLUX_BUCKET=wwtp

# Local host port mapping. Change if these collide with something on your machine.
INFLUX_PORT=8086

# Retention targets, in seconds. Enforced by the rollup worker, not the engine.
# 7d raw @1s · 90d @1min · indefinite @1h
RETENTION_RAW_SECONDS=604800
RETENTION_1M_SECONDS=7776000

# ─── Couchbase (Developer Edition) ────────────────────────────────────────────
# Free, no licence key required. Paths inside the container only.
COUCHBASE_BUCKET=wwtp
COUCHBASE_USER=wwtp_app
COUCHBASE_PASSWORD=change-me-before-first-run
COUCHBASE_ADMIN_USER=Administrator
COUCHBASE_ADMIN_PASSWORD=change-me-before-first-run

COUCHBASE_PORT=8091
COUCHBASE_KV_PORT=11210

# ─── PLC simulation (softplc) ──────────────────────────────────────────────────
# Published to host AND on the internal network. Gateway connects by service name.
MODBUS_PORT=5020
OPCUA_PORT=4840
PLC_SCAN_MS=20
OPCUA_ENDPOINT=opc.tcp://softplc:4840/wwtp/server/

# ─── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_LOG_LEVEL=INFO
# Deadband applied to every tag unless overridden in contracts/tags.yaml
GATEWAY_DEADBAND_DEFAULT=0.0
# Where the store-and-forward spool lives
GATEWAY_SPOOL_DIR=/app/spool
GATEWAY_SPOOL_MAX_MB=512

# ─── Rollup / alarm worker ─────────────────────────────────────────────────────
ROLLUP_INTERVAL_SECONDS=60
# Discard an in-progress window rather than writing a partial bucket
ROLLUP_DISCARD_PARTIAL=true
ALARM_EVAL_INTERVAL_SECONDS=5

# ─── Seed / demo data ──────────────────────────────────────────────────────────
# On first start, generate N days of history so dashboards are not empty.
SEED_DAYS=7
# When true, the storm scenario auto-arms some time after start
DEMO_STORM_AT_HOURS=2

# ─── UI ────────────────────────────────────────────────────────────────────────
GRAFANA_PORT=3000
WEB_PORT=3001
