# ─────────────────────────────────────────────────────────────────────────────
# wwtp-iiot — example environment
#
# Copy to .env and fill in real values:      cp .env.example .env
# .env is gitignored. NEVER commit real values here.
#
# There is nothing marked REQUIRED any more, and that is the single biggest
# operational change from the previous stack. It used to start with a line
# reading
#
#     INFLUX_LICENSE_KEY=replace-me-with-your-home-use-licence-key
#
# and a comment explaining that InfluxDB 3 Enterprise refuses to start without
# one, that the licence is non-commercial and home-use only, and that the key
# had to be obtained from InfluxData by a human. Every fresh `docker compose up`
# on a new machine began by failing, for a reason that had nothing to do with the
# project.
#
# The database is now Postgres, which has no licence key, no edition to choose
# between, and no edition whose behaviour differs. The placeholders below are
# placeholders because a password should not be a default, not because the
# software will not run without one.
#
# Change every value below before putting this anywhere that is not your laptop.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Postgres + TimescaleDB ───────────────────────────────────────────────────
POSTGRES_USER=wwtp
# Replace this. It is the application's own credential, and in a real plant it
# would be scoped to the `wwtp` database and to the tables in it — see
# docs/SECURITY.md for the grants that make that true, and for the two gaps that
# are still open.
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=wwtp

# The gateway's own database credential. Created at run time by `init-db` as a
# LOGIN role that is a member of `wwtp_writer` and of nothing else: it can insert
# a reading and it cannot delete one, drop a table, or change the contract.
#
# It is REQUIRED, and compose will refuse to start without it. That is on purpose.
# It used to fall back to POSTGRES_PASSWORD, and the two variables could disagree:
# `login_role.py` set the role's password from this one while `schema.dsn()`
# connected with the other, so setting this — the documented, correct thing to do
# — made the gateway fail to authenticate at all. One variable, one meaning.
#
# Two consequences worth knowing:
#
#   * `init-db` is a one-shot service. After changing either password here, run
#         docker compose up -d --force-recreate init-db
#         docker compose up -d --force-recreate gateway web
#     `docker compose restart` does NOT pick up a changed environment, and the
#     symptom is an authentication failure that looks like a code bug.
#   * the gateway's health check verifies it cannot TRUNCATE reading, so it fails
#     loudly if the role turns out to have owner privileges.
GATEWAY_DB_ROLE=wwtp_gateway
GATEWAY_DB_PASSWORD=replace-me-if-you-can

# The web dashboard's database credential. Created at run time as a LOGIN role
# in `wwtp_reader` and of nothing else — it can read the historian, the rollups
# and the event log, and it cannot write, update or delete any of them.
#
# The page has no write path at all, so a read-only role costs nothing and is
# exactly the right grant. It is also the example to copy for the Node-RED
# service, which still authenticates as the owner: see the open thread at the top
# of docs/LEARNING-LOG.md.
WEB_DB_ROLE=wwtp_ui
WEB_DB_PASSWORD=replace-me-too

# Local host port mapping. Change if these collide with something on your
# machine. The container always listens on 5432 internally; only this is remapped.
POSTGRES_PORT=5432

# Retention, in days. Attached as Timescale policies rather than enforced in
# application code, which is the point of using the extension.
#   7 d at 1 s raw · 90 d at 1 min · indefinitely at 1 h
# 0 disables a policy.
RETENTION_RAW_DAYS=7
RETENTION_MINUTE_DAYS=90

# ─── soft PLC ─────────────────────────────────────────────────────────────────
SOFTPLC_SCAN_HZ=${SOFTPLC_SCAN_HZ:-50}
SOFTPLC_MODBUS_PORT=5020
SOFTPLC_OPCUA_PORT=4840
SOFTPLC_SEED=${SOFTPLC_SEED:-20260926}

# ─── gateway ──────────────────────────────────────────────────────────────────
GATEWAY_LOG_LEVEL=INFO
# A deadband of 0 disables filtering entirely: every sample is written. Useful
# for a first run, ruinous at 1 Hz forever.
GATEWAY_DEADBAND_DEFAULT=0.0
GATEWAY_SPOOL_MAX_MB=512

# ─── web / Next.js ───────────────────────────────────────────────────────────
WEB_PORT=3001
# Phase 5 has not been written, so ui/web has no package.json and no app. The
# service is behind the `ui` profile and will not build. See compose.yaml.
#NEXT_PUBLIC_POSTGRES_URL=PLACEHOLDER

# ─── Grafana (profile: observability) ────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# ─── demo profile: seeded history ────────────────────────────────────────────
# Days of simulated plant history. The seeder replays the real process model
# through real fault scenarios at roughly 40 000 readings/second, so a week is
# about half a minute.
SEED_DAYS=7
# Hours before the *end* of the run to arm the wet-weather storm, so it lands
# inside the default dashboard window. Negative to skip.
DEMO_STORM_AT_HOURS=2

# ─── integration tests ────────────────────────────────────────────────────────
# Point the test suite at a throwaway database on a different port rather than
# the compose one, so a failing test cannot truncate real history.
POSTGRES_TEST_PORT=55432
