# ─── Secrets ───────────────────────────────────────────────────────────────────
# .env holds real values. It is NEVER committed. Copy .env.example → .env and fill in.
.env
.env.*
!.env.example

# InfluxDB licence key, if ever pasted into a shell history or a file
*.lic
license.key

# ─── Databases / state ─────────────────────────────────────────────────────────
# Local database state must not shadow the Docker volumes
storage/influx/data/
storage/influx/meta/
storage/couchbase/data/
storage/couchbase/logs/
storage/couchbase/config/
data/
*.db
*.sqlite
*.sqlite3
*.sst
*.lmdb

# ─── Integration-test credentials ─────────────────────────────────────────────
# A token written by hand while poking at a local InfluxDB. The suite reads
# INFLUX_TEST_TOKEN from the environment instead, which is the right way; this
# entry exists because the convenient way happened once.
tests/integration/influx_token

# ─── Gateway store-and-forward spool ───────────────────────────────────────────
# Runtime buffer, may contain plant data. Never commit.
gateway/spool/*.jsonl
gateway/spool/*.db
gateway/spool/*.wal

# NOT a bare `spool/`.
#
# An unanchored `spool/` matches any directory called `spool` at **any** depth,
# and `gateway/spool/` is the source package — `spool/__init__.py` and
# `spool/store.py`, 19 kB, imported by `gateway/main.py` and by three test
# modules. The three patterns above already cover the runtime data it holds.
#
# So this rule silently untracked a package the project cannot import. Nothing
# local noticed, because the files are on disk either way; CI reported
# `ModuleNotFoundError: No module named 'gateway.spool'` in five test modules,
# in every run since the spool directory was created.
#
# The rule is anchored to the repository root instead, so a future root-level
# spool is still ignored and no source package can be caught by it.
# `tests/test_readme_claims.py` asserts that every tracked Python file is still
# tracked, which is the check that would have caught it.
/spool/

# ─── Node-RED ──────────────────────────────────────────────────────────────────
# flows.json is generated by the editor and would clobber the reviewed source of
# truth in scada/flows/*.json. The .env file often holds editor credentials.
node_modules/
scada/node_modules/
scada/nodered/node_modules/
scada/nodered/package-lock.json

# Generated by scada/nodered/entrypoint.sh, from the environment, and never
# committed: it holds the database password and the key it is encrypted with.
# In the running stack it lives in a named volume; these patterns are for anyone
# who runs the entrypoint outside compose.
scada/flows/flows_cred.json
scada/flows/.credentialSecret
flows_cred.json
.credentialSecret
node-red/
flows.json
credentials.json
scada/.env*
!scada/.env.example

# ─── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ─── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
ui/web/node_modules/
ui/web/.next/
ui/web/out/
ui/web/.turbo/
# `tsc --noEmit` with `incremental: true` writes this, and it is a cache of the
# check rather than anything about the project. It also goes stale against
# `node_modules`, so committing it produces a `tsc` that trusts a lockfile
# version nobody has.
ui/web/tsconfig.tsbuildinfo
ui/web/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.nvmrc.timestamp

# ─── Test / quality artefacts ──────────────────────────────────────────────────
# sql/_answers/ IS committed (golden output). Everything else is not.
sql/**/actual_*
sql/**/*.timing
tests/artifacts/
tests/screenshots/

# ─── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-*

# ─── Logs / temp ───────────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.pid
*.seed

# Notebook figures. Derived from the data on every run, and a committed PNG is a
# picture of a database that no longer exists — the same failure mode as a pasted
# output block, which is why `notebooks/src/*.md` carries the claims instead.
notebooks/figures/

# JupyterLab's autosave checkpoints. A `.ipynb_checkpoints/` directory appears the
# first time anyone opens a notebook, and its contents are a mid-session copy of a
# file that is generated from `notebooks/src/*.md` anyway — so it is drift with a
# timestamp on it, and committing one puts a half-written notebook in the history.
notebooks/.ipynb_checkpoints/

# Executed HTML from `make notebooks-read`. Derived from the data, like figures.
notebooks/read/
