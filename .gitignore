# ─── Secrets ───────────────────────────────────────────────────────────────────
# .env holds real values. It is NEVER committed. Copy .env.example → .env and fill in.
.env
.env.*
!.env.example

# InfluxDB licence key, if ever pasted into a shell history or a file
*.lic
license.key

# ─── Databases / state ─────────────────────────────────────────────────────────
# Local database state must not shadow the Docker volumes
storage/influx/data/
storage/influx/meta/
storage/couchbase/data/
storage/couchbase/logs/
storage/couchbase/config/
data/
*.db
*.sqlite
*.sqlite3
*.sst
*.lmdb

# ─── Gateway store-and-forward spool ───────────────────────────────────────────
# Runtime buffer, may contain plant data. Never commit.
gateway/spool/*.jsonl
gateway/spool/*.db
gateway/spool/*.wal
spool/

# ─── Node-RED ──────────────────────────────────────────────────────────────────
# flows.json is generated by the editor and would clobber the reviewed source of
# truth in scada/flows/*.json. The .env file often holds editor credentials.
node_modules/
scada/node_modules/
node-red/
flows.json
credentials.json
scada/.env*
!scada/.env.example

# ─── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ─── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
ui/web/node_modules/
ui/web/.next/
ui/web/out/
ui/web/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.nvmrc.timestamp

# ─── Test / quality artefacts ──────────────────────────────────────────────────
# sql/_answers/ IS committed (golden output). Everything else is not.
sql/**/actual_*
sql/**/*.timing
tests/artifacts/
tests/screenshots/

# ─── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-*

# ─── Logs / temp ───────────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.pid
*.seed
